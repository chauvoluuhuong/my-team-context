# Team Context Panel Admin Login
AUTH_USERNAME=
AUTH_PASSWORD=

# GitHub Personal Access Token (classic with repo scope, or fine-grained with Contents: Read-only)
GITHUB_TOKEN=

# Notion Internal Integration Token (secret_...)
NOTION_API_KEY=

# Qdrant Vector Database URL (Cloud Qdrant or self-hosted)
QDRANT_URL=https://xxx.cloud.qdrant.io

# Qdrant API Key (required for Cloud Qdrant)
QDRANT_API_KEY=

# SQL Database Connection String (PostgreSQL, MySQL, SQLite, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Google Gemini API Key (for text-embedding-004 vector embeddings)
GEMINI_API_KEY=

