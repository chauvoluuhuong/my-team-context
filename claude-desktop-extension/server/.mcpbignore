# Ignore root package output and temp files
*.mcpb
*.pmcp
.DS_Store

# Ignore test files
test/

# Unignore compiled server code and node_modules dependencies
!dist
!dist/**
!node_modules
!node_modules/**
!widgets
!widgets/**
!DEFAULT_SYSTEM_PROMPT

# Always ignore all .env files and local secrets (must remain at bottom after ! unignore rules)
.env
.env*
.env.*
*.env
*.env.*
**/.env
**/.env*
**/.env.*
.env.example
