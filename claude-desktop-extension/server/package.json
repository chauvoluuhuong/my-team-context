{
  "name": "automate-work-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server backing the Automate Work extension",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector node --watch --import tsx src/index.ts",
    "build:ts": "tsc",
    "build": "npm run build:ts && npm test && npm run validate && npm run build:deps && npm run build:pack && npm install",
    "build:deps": "npm install --omit=dev --no-audit --no-fund",
    "build:pack": "node -e \"require('node:fs').mkdirSync('../../dist',{recursive:true}); require('node:fs').mkdirSync('../dist',{recursive:true})\" && npx --yes @anthropic-ai/mcpb pack .. ../../dist/automate-work.mcpb && node -e \"require('node:fs').copyFileSync('../../dist/automate-work.mcpb', '../dist/automate-work.mcpb'); require('node:fs').copyFileSync('../../dist/automate-work.mcpb', '../../dist/automate-work.pmcp'); require('node:fs').copyFileSync('../../dist/automate-work.mcpb', '../dist/automate-work.pmcp')\"",
    "validate": "npx --yes @anthropic-ai/mcpb validate ../manifest.json",
    "info": "npx --yes @anthropic-ai/mcpb info ../../dist/automate-work.mcpb",
    "test": "npx --yes tsx test/api.ts",
    "test:mention": "npx --yes tsx test/mention-and-refine.ts",
    "smoke": "npx --yes tsx test/smoke.ts",
    "inspect": "npx --yes @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mysql2": "^3.24.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
